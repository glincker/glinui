{
  "name": "@glinui/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "showcase:code": "node scripts/gen-showcase-s1-code.mjs && node scripts/gen-showcase-s2-code.mjs && node scripts/gen-s3-code.mjs && node scripts/gen-s5-code.mjs",
    "preregistry": "pnpm showcase:code && node scripts/build-registry-endpoints.mjs && node scripts/generate-ai-docs.mjs",
    "predev": "pnpm metadata:generate && pnpm preregistry",
    "dev": "next dev -p 3002",
    "dev:restart": "sh -c 'PIDS=$(lsof -ti tcp:3002); if [ -n \"$PIDS\" ]; then kill $PIDS; fi; next dev -p 3002'",
    "prebuild": "rm -rf .next && pnpm metadata:generate && pnpm preregistry",
    "build": "next build",
    "start": "next start -p 3002",
    "pretypecheck": "pnpm metadata:generate",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: @glinui/docs (todo)'",
    "pretest": "pnpm metadata:generate && pnpm preregistry",
    "test": "node --test tests/**/*.test.mjs",
    "api:generate": "node scripts/generate-api-metadata.mjs",
    "api:audit": "node scripts/audit-api-tables.mjs",
    "api:cleanup-safe": "node scripts/cleanup-safe-api-tables.mjs",
    "registry:generate": "node scripts/generate-registry-metadata.mjs",
    "metadata:generate": "pnpm api:generate && pnpm registry:generate",
    "docs:sweep": "node scripts/docs-sweep.mjs",
    "ai-docs:generate": "node scripts/generate-ai-docs.mjs",
    "registry:endpoints": "pnpm preregistry",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/check-upstream-licenses.mjs",
    "audit:classes": "node scripts/audit-classes.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "seo:ping": "node scripts/seo-ping.mjs"
  },
  "dependencies": {
    "@glinui/motion": "workspace:*",
    "@glinui/registry": "workspace:*",
    "@glinui/tokens": "workspace:*",
    "@glinui/ui": "workspace:*",
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^15.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.15.0",
    "motion": "^14.0.0",
    "next": "^15.3.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "thesvg": "^3.3.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
