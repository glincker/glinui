{
  "name": "@glinui/motion",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engines/css": {
      "types": "./dist/engines/css.d.ts",
      "default": "./dist/engines/css.js"
    },
    "./engines/motion": {
      "types": "./dist/engines/motion.d.ts",
      "default": "./dist/engines/motion.js"
    },
    "./engines/gsap": {
      "types": "./dist/engines/gsap.d.ts",
      "default": "./dist/engines/gsap.js"
    },
    "./register/motion": {
      "types": "./dist/register/motion.d.ts",
      "default": "./dist/register/motion.js"
    },
    "./register/gsap": {
      "types": "./dist/register/gsap.d.ts",
      "default": "./dist/register/gsap.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GLINCKER/glinui",
    "directory": "packages/motion"
  },
  "homepage": "https://glinui.com",
  "bugs": "https://github.com/GLINCKER/glinui/issues",
  "keywords": [
    "glinui",
    "glassmorphism",
    "liquid-glass",
    "react",
    "tailwindcss",
    "ui",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: @glinui/motion (todo)'",
    "test": "echo 'test: @glinui/motion (todo)'"
  },
  "devDependencies": {
    "gsap": "^3.15.0",
    "motion": "^14.0.0"
  },
  "peerDependencies": {
    "gsap": "^3.12.0",
    "motion": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    },
    "motion": {
      "optional": true
    }
  },
  "sideEffects": [
    "./dist/register/*.js"
  ]
}
