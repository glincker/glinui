{
  "name": "@glinui/registry",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GLINCKER/glinui",
    "directory": "packages/registry"
  },
  "homepage": "https://glinui.com",
  "bugs": "https://github.com/GLINCKER/glinui/issues",
  "keywords": [
    "glinui",
    "glassmorphism",
    "liquid-glass",
    "react",
    "tailwindcss",
    "ui",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm registry:generate && tsc -p tsconfig.json && node scripts/fix-dist-imports.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: @glinui/registry (todo)'",
    "test": "node scripts/validate-artifacts.mjs && node --test scripts/*.test.mjs",
    "registry:generate": "node scripts/generate-artifacts.mjs"
  }
}
