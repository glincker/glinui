{
  "name": "@glinui/tokens",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./utilities.css": "./utilities.css",
    "./animations.css": "./animations.css",
    "./preferences.css": "./preferences.css",
    "./bases.css": "./bases.css",
    "./tailwind-preset": {
      "types": "./tailwind-preset.d.ts",
      "default": "./tailwind-preset.cjs"
    },
    "./tailwind4.css": "./tailwind4.css",
    "./tailwind4-unprefixed.css": "./tailwind4-unprefixed.css",
    "./tailwind4-animate.css": "./tailwind4-animate.css"
  },
  "files": [
    "dist",
    "theme.css",
    "utilities.css",
    "animations.css",
    "preferences.css",
    "bases.css",
    "tailwind-animate.cjs",
    "tailwind-preset.cjs",
    "tailwind-preset.d.ts",
    "tailwind4.css",
    "tailwind4-unprefixed.css",
    "tailwind4-animate.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GLINCKER/glinui",
    "directory": "packages/tokens"
  },
  "homepage": "https://glinui.com",
  "bugs": "https://github.com/GLINCKER/glinui/issues",
  "keywords": [
    "glinui",
    "glassmorphism",
    "liquid-glass",
    "react",
    "tailwindcss",
    "ui",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bases:build": "node scripts/build-bases.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: @glinui/tokens (todo)'",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4",
    "tailwindcss": "^4",
    "vitest": "3.2.4"
  }
}
